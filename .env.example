OPENAI_API_KEY=your_openai_key_here
COHERE_API_KEY=your_cohere_key_here
TAVILY_API_KEY=your_tavily_key_here
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LLM_MODEL=gpt-4o-mini

# OpenRouter (optional — use free/open-source models; get key at openrouter.ai)
# Set LLM_PROVIDER=openrouter and OPENROUTER_API_KEY=sk-or-... to route chat through OpenRouter.
# Then set LLM_MODEL to an OpenRouter model id, e.g. meta-llama/Meta-Llama-3-8B-Instruct
OPENROUTER_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL_CLOSED=openai/gpt-4o-mini
LLM_MODEL_OPEN=meta-llama/Meta-Llama-3-8B-Instruct
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=10
TOP_K_RERANK=3
RELEVANCE_SCORE_THRESHOLD=0.6

# Google Maps routing (optional — enables live route data and folium maps)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenWeatherMap MCP server (optional — mock weather used if not set)
# Free tier: 1M calls/month — sign up at openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_openweathermap_key_here
WEATHER_UNITS=imperial

# LangSmith tracing (optional — set LANGCHAIN_TRACING_V2=true to enable)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=transOrchestra
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
